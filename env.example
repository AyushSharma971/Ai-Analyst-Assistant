# Nevag agent config. All NEVAG_-prefixed so they never clash with the One AI
# host's own vars (BACKEND_API_URL, AZURE_OPENAI_*, etc.).
# Copy to .env  ->  cp env.example .env
#
# SECURITY: never commit real secrets here. This is a template. Put real keys in
# .env (gitignored). If a key was ever pasted here, ROTATE it.

NEVAG_AGENT_NAME=Nevag Submission Triage
NEVAG_ENVIRONMENT=dev

# One AI registration (Agent Marketplace). agent_backend_url is where THIS
# service is reachable; the One AI frontend calls {agent_backend_url}/{slug}.
# oneai_register_url is the core-backend endpoint used by scripts/register_agent.py.
NEVAG_AGENT_SOURCE=agent studio
NEVAG_AGENT_BACKEND_URL=
NEVAG_ONEAI_REGISTER_URL=

# LLM: ollama (local default) | mock | azure_openai (optional cloud adapter).
# Offline / Ollama not running -> the brain falls back to the deterministic
# heuristic extractor automatically.
NEVAG_LLM_PROVIDER=ollama
NEVAG_OLLAMA_BASE_URL=http://localhost:11434
NEVAG_LLM_MODEL=llama3.1
NEVAG_LLM_TEMPERATURE=0.0
# Optional cloud adapter (only used when NEVAG_LLM_PROVIDER=azure_openai):
NEVAG_AZURE_OPENAI_API_KEY=
NEVAG_AZURE_OPENAI_ENDPOINT=
NEVAG_AZURE_OPENAI_API_VERSION=2024-12-01-preview
NEVAG_AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# Provider robustness (mock provider ignores these)
NEVAG_LLM_MAX_RETRIES=2
NEVAG_LLM_TIMEOUT_SECONDS=30
NEVAG_LLM_RETRY_BACKOFF_SECONDS=0

# Document AI / OCR
# ocr_provider: auto (default) | azure_doc_intel | tesseract | none
NEVAG_OCR_PROVIDER=auto
NEVAG_AZURE_DOC_INTEL_ENDPOINT=
NEVAG_AZURE_DOC_INTEL_KEY=
NEVAG_TESSERACT_CMD=
NEVAG_SCANNED_TEXT_THRESHOLD=20
NEVAG_OCR_DPI=200
NEVAG_OCR_ENABLE_FALLBACK=true
NEVAG_DOC_AI_MAX_WORKERS=1          # >1 parses files in parallel (deterministic)

# Extraction (config-driven). Blank paths use the bundled config/*.json files.
NEVAG_ATTRIBUTE_CATALOG_PATH=
NEVAG_PROMPTS_PATH=
NEVAG_VALUE_TOKENS_PATH=
NEVAG_EXTRACT_CONFIDENCE_PRIMARY=0.85
NEVAG_EXTRACT_CONFIDENCE_ALIAS=0.80
NEVAG_EXTRACT_DEFAULT_CONFIDENCE=0.50
NEVAG_EXTRACT_SNIPPET_MAX_CHARS=300
NEVAG_EXTRACT_LABEL_GAP_MAX_CHARS=40
NEVAG_EXTRACT_ENABLE_HEURISTIC_FALLBACK=true

# Validation: fields below this confidence go to review; numeric equality tolerance.
NEVAG_VALIDATION_MIN_CONFIDENCE=0.80
NEVAG_VALIDATION_NUMERIC_TOLERANCE=1e-9
# Source-priority resolution of cross-document contradictions (blank path => bundled).
NEVAG_CONTRADICTION_USE_SOURCE_PRIORITY=true
NEVAG_SOURCE_PRIORITY_PATH=
NEVAG_EXTRACT_CONFIDENCE_TABLE=0.82
NEVAG_NUMBER_UNITS_PATH=

# Observability (structured logging + run metrics)
NEVAG_LOG_ENABLED=true
NEVAG_LOG_LEVEL=WARNING
NEVAG_LOG_FORMAT=text

# Classification / ontology / risk (blank => bundled config files).
NEVAG_INDUSTRY_TAXONOMY_PATH=
NEVAG_ONTOLOGY_RULES_PATH=
NEVAG_RISK_RULES_PATH=
NEVAG_PROMPT_VERSION=extraction-v1
NEVAG_CANONICAL_SCHEMA_VERSION=nevag-canonical-v1

# External research defaults (no approved sources ship by default).
NEVAG_RESEARCH_DEFAULT_CONFIDENCE=0.50
NEVAG_RESEARCH_DEFAULT_STATUS=review

# Carrier mapping + Safe Excel Autofill. Leave mapping path blank to use the
# bundled config/carrier_mapping.json. rater_template_path is the blank carrier
# rater workbook; filled copies are written to rater_output_dir.
NEVAG_CARRIER_MAPPING_PATH=
NEVAG_DEFAULT_CARRIER=default
NEVAG_RATER_TEMPLATE_PATH=
NEVAG_RATER_OUTPUT_DIR=

# Registration POST timeout (seconds).
NEVAG_REGISTRATION_TIMEOUT_SECONDS=30

# Retrieval: vector store + embeddings. Backend is pluggable.
# vector_store: qdrant (default) | azure_search | memory | none
# Offline / no Qdrant URL -> falls back to an in-memory store automatically.
NEVAG_VECTOR_STORE=qdrant
NEVAG_QDRANT_URL=
NEVAG_QDRANT_API_KEY=
NEVAG_QDRANT_COLLECTION=nevag_documents
# Azure AI Search (optional fallback backend)
NEVAG_AZURE_SEARCH_ENDPOINT=
NEVAG_AZURE_SEARCH_API_KEY=
NEVAG_AZURE_SEARCH_INDEX=nevag-documents
# Embeddings (local-first; falls back to deterministic mock offline).
# ollama=bge-m3 (dim 1024) | sentence_transformers=all-MiniLM-L6-v2 (dim 384) |
# azure_openai (optional, ada-002 dim 1536). Keep EMBEDDING_DIM aligned to model.
NEVAG_EMBEDDING_PROVIDER=ollama
NEVAG_EMBEDDING_MODEL=bge-m3
NEVAG_EMBEDDING_DEPLOYMENT=chatbot-text-embedding-ada-002
NEVAG_EMBEDDING_DIM=1024
# Chunking + retrieval
NEVAG_EMBEDDING_CACHE_ENABLED=true
NEVAG_EMBEDDING_CACHE_BACKEND=memory   # memory | sqlite (persistent across runs)
NEVAG_EMBEDDING_CACHE_PATH=
NEVAG_CHUNK_SIZE=800
NEVAG_CHUNK_OVERLAP=100
NEVAG_RETRIEVAL_TOP_K=5
# Retrieval-augmented extraction (RAG). OFF by default -> deterministic full-text
# extraction remains the offline floor. Enable to retrieve focused per-attribute
# context from the vector store before extracting.
NEVAG_RAG_EXTRACTION_ENABLED=false
NEVAG_RAG_TOP_K=4
NEVAG_RAG_PER_ATTRIBUTE_PROMPTS=false   # one focused LLM call per attribute
NEVAG_RETRIEVAL_MIN_SCORE=0.0
NEVAG_OCR_CONFIDENCE_FLOOR=0.0
# Hybrid retrieval: dense + BM25 -> RRF fusion -> MMR diversify -> rerank
NEVAG_RETRIEVAL_HYBRID=true
NEVAG_RETRIEVAL_PREFETCH_K=20
NEVAG_RRF_K=60
NEVAG_BM25_K1=1.5
NEVAG_BM25_B=0.75
NEVAG_MMR_ENABLED=true
NEVAG_MMR_LAMBDA=0.5
NEVAG_MMR_POOL=12
# rerank_provider: heuristic (offline) | none | cross_encoder (needs a model)
NEVAG_RERANK_PROVIDER=heuristic
NEVAG_RERANK_WEIGHT_BASE=1.0
NEVAG_RERANK_WEIGHT_LEXICAL=0.5
# Validation evidence-supply via retrieval (decisions remain rule-based)
NEVAG_VALIDATION_USE_RETRIEVAL=false

# Storage / DB (own, namespaced). Local default = in-memory. For persistence:
#   sqlite:///./nevag_state.db   (local file, stdlib, no deps)
#   postgresql+psycopg://user:pass@host/nevag   (optional)
NEVAG_DATABASE_URL=
NEVAG_BLOB_CONTAINER_URL=
NEVAG_STATE_PERSIST_SLIM=true       # drop raw bytes / full text from stored state

# Intake paths (both supported)
NEVAG_UPLOAD_ENABLED=true
NEVAG_MAILBOX_ENABLED=false
