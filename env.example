# nebag agent config. All nebag_-prefixed so they never clash with the One AI
# host's own vars (BACKEND_API_URL, AZURE_OPENAI_*, etc.).
# Copy to .env  ->  cp env.example .env
#
# SECURITY: never commit real secrets here. This is a template. Put real keys in
# .env (gitignored). If a key was ever pasted here, ROTATE it.

nebag_AGENT_NAME=nebag Submission Triage
nebag_ENVIRONMENT=dev

# One AI registration (Agent Marketplace). agent_backend_url is where THIS
# service is reachable; the One AI frontend calls {agent_backend_url}/{slug}.
# oneai_register_url is the core-backend endpoint used by scripts/register_agent.py.
nebag_AGENT_SOURCE=agent studio
nebag_AGENT_BACKEND_URL=
nebag_ONEAI_REGISTER_URL=

# LLM: ollama (local default) | mock | azure_openai (optional cloud adapter).
# Offline / Ollama not running -> the brain falls back to the deterministic
# heuristic extractor automatically.
nebag_LLM_PROVIDER=ollama
nebag_OLLAMA_BASE_URL=http://localhost:11434
nebag_LLM_MODEL=llama3.1
nebag_LLM_TEMPERATURE=0.0
# Optional cloud adapter (only used when nebag_LLM_PROVIDER=azure_openai):
nebag_AZURE_OPENAI_API_KEY=
nebag_AZURE_OPENAI_ENDPOINT=
nebag_AZURE_OPENAI_API_VERSION=2024-12-01-preview
nebag_AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# Provider robustness (mock provider ignores these)
nebag_LLM_MAX_RETRIES=2
nebag_LLM_TIMEOUT_SECONDS=30
nebag_LLM_RETRY_BACKOFF_SECONDS=0

# Document AI / OCR
# ocr_provider: auto (default) | azure_doc_intel | tesseract | none
nebag_OCR_PROVIDER=auto
nebag_AZURE_DOC_INTEL_ENDPOINT=
nebag_AZURE_DOC_INTEL_KEY=
nebag_TESSERACT_CMD=
nebag_SCANNED_TEXT_THRESHOLD=20
nebag_OCR_DPI=200
nebag_OCR_ENABLE_FALLBACK=true
nebag_DOC_AI_MAX_WORKERS=1          # >1 parses files in parallel (deterministic)

# Extraction (config-driven). Blank paths use the bundled config/*.json files.
nebag_ATTRIBUTE_CATALOG_PATH=
nebag_PROMPTS_PATH=
nebag_VALUE_TOKENS_PATH=
nebag_EXTRACT_CONFIDENCE_PRIMARY=0.85
nebag_EXTRACT_CONFIDENCE_ALIAS=0.80
nebag_EXTRACT_DEFAULT_CONFIDENCE=0.50
nebag_EXTRACT_SNIPPET_MAX_CHARS=300
nebag_EXTRACT_LABEL_GAP_MAX_CHARS=40
nebag_EXTRACT_ENABLE_HEURISTIC_FALLBACK=true

# Validation: fields below this confidence go to review; numeric equality tolerance.
nebag_VALIDATION_MIN_CONFIDENCE=0.80
nebag_VALIDATION_NUMERIC_TOLERANCE=1e-9
# Source-priority resolution of cross-document contradictions (blank path => bundled).
nebag_CONTRADICTION_USE_SOURCE_PRIORITY=true
nebag_SOURCE_PRIORITY_PATH=
nebag_EXTRACT_CONFIDENCE_TABLE=0.82
nebag_NUMBER_UNITS_PATH=

# Observability (structured logging + run metrics)
nebag_LOG_ENABLED=true
nebag_LOG_LEVEL=WARNING
nebag_LOG_FORMAT=text

# Classification / ontology / risk (blank => bundled config files).
nebag_INDUSTRY_TAXONOMY_PATH=
nebag_ONTOLOGY_RULES_PATH=
nebag_RISK_RULES_PATH=
nebag_PROMPT_VERSION=extraction-v1
nebag_CANONICAL_SCHEMA_VERSION=nebag-canonical-v1

# External research defaults (no approved sources ship by default).
nebag_RESEARCH_DEFAULT_CONFIDENCE=0.50
nebag_RESEARCH_DEFAULT_STATUS=review

# Carrier mapping + Safe Excel Autofill. Leave mapping path blank to use the
# bundled config/carrier_mapping.json. rater_template_path is the blank carrier
# rater workbook; filled copies are written to rater_output_dir.
nebag_CARRIER_MAPPING_PATH=
nebag_DEFAULT_CARRIER=default
nebag_RATER_TEMPLATE_PATH=
nebag_RATER_OUTPUT_DIR=

# Registration POST timeout (seconds).
nebag_REGISTRATION_TIMEOUT_SECONDS=30

# Retrieval: vector store + embeddings. Backend is pluggable.
# vector_store: qdrant (default) | azure_search | memory | none
# Offline / no Qdrant URL -> falls back to an in-memory store automatically.
nebag_VECTOR_STORE=qdrant
nebag_QDRANT_URL=
nebag_QDRANT_API_KEY=
nebag_QDRANT_COLLECTION=nebag_documents
# Azure AI Search (optional fallback backend)
nebag_AZURE_SEARCH_ENDPOINT=
nebag_AZURE_SEARCH_API_KEY=
nebag_AZURE_SEARCH_INDEX=nebag-documents
# Embeddings (local-first; falls back to deterministic mock offline).
# ollama=bge-m3 (dim 1024) | sentence_transformers=all-MiniLM-L6-v2 (dim 384) |
# azure_openai (optional, ada-002 dim 1536). Keep EMBEDDING_DIM aligned to model.
nebag_EMBEDDING_PROVIDER=ollama
nebag_EMBEDDING_MODEL=bge-m3
nebag_EMBEDDING_DEPLOYMENT=chatbot-text-embedding-ada-002
nebag_EMBEDDING_DIM=1024
# Chunking + retrieval
nebag_EMBEDDING_CACHE_ENABLED=true
nebag_EMBEDDING_CACHE_BACKEND=memory   # memory | sqlite (persistent across runs)
nebag_EMBEDDING_CACHE_PATH=
nebag_CHUNK_SIZE=800
nebag_CHUNK_OVERLAP=100
nebag_RETRIEVAL_TOP_K=5
# Retrieval-augmented extraction (RAG). OFF by default -> deterministic full-text
# extraction remains the offline floor. Enable to retrieve focused per-attribute
# context from the vector store before extracting.
nebag_RAG_EXTRACTION_ENABLED=false
nebag_RAG_TOP_K=4
nebag_RAG_PER_ATTRIBUTE_PROMPTS=false   # one focused LLM call per attribute
nebag_RETRIEVAL_MIN_SCORE=0.0
nebag_OCR_CONFIDENCE_FLOOR=0.0
# Hybrid retrieval: dense + BM25 -> RRF fusion -> MMR diversify -> rerank
nebag_RETRIEVAL_HYBRID=true
nebag_RETRIEVAL_PREFETCH_K=20
nebag_RRF_K=60
nebag_BM25_K1=1.5
nebag_BM25_B=0.75
nebag_MMR_ENABLED=true
nebag_MMR_LAMBDA=0.5
nebag_MMR_POOL=12
# rerank_provider: heuristic (offline) | none | cross_encoder (needs a model)
nebag_RERANK_PROVIDER=heuristic
nebag_RERANK_WEIGHT_BASE=1.0
nebag_RERANK_WEIGHT_LEXICAL=0.5
# Validation evidence-supply via retrieval (decisions remain rule-based)
nebag_VALIDATION_USE_RETRIEVAL=false

# Storage / DB (own, namespaced). Local default = in-memory. For persistence:
#   sqlite:///./nebag_state.db   (local file, stdlib, no deps)
#   postgresql+psycopg://user:pass@host/nebag   (optional)
nebag_DATABASE_URL=
nebag_BLOB_CONTAINER_URL=
nebag_STATE_PERSIST_SLIM=true       # drop raw bytes / full text from stored state

# Intake paths (both supported)
nebag_UPLOAD_ENABLED=true
nebag_MAILBOX_ENABLED=false
